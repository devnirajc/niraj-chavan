---
/**
 * Contact — more than a form: availability, the kinds of work I'm open to,
 * the fastest ways to reach me, scheduling, and where else to find me.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import CopyButton from '@/components/ui/CopyButton.astro';
import DraftBadge from '@/components/ui/DraftBadge.astro';
import ContactForm from '@/components/content/ContactForm.astro';
import { profile } from '@/data/profile';
import { SHOW_DRAFTS } from '@/lib/drafts';
import { href } from '@/lib/url';

const { availability, workTypes, calendlyUrl } = profile;
const showWorkTypes = SHOW_DRAFTS || !workTypes.draft;
const toneClass = {
  open: 'bg-success ring-success/25',
  selective: 'bg-success ring-success/25',
  unavailable: 'bg-line-strong ring-line/40',
}[availability.status];
---

<BaseLayout title="Contact" description={`Get in touch with ${profile.name}: availability, email, scheduling and profiles.`}>
  <PageHeader eyebrow="Contact" title="Let's talk" lede={availability.detail}>
    <p class="mt-7 inline-flex items-center gap-3 rounded-full border border-line bg-surface py-2 pr-4 pl-3 text-sm shadow-sm">
      <span aria-hidden="true" class:list={['size-2.5 rounded-full ring-4', toneClass]}></span>
      <span class="font-medium text-fg">{availability.label}</span>
      <span class="text-fg-subtle">· {profile.location} · {profile.timezone}</span>
    </p>
  </PageHeader>

  <div class="container-page grid gap-10 pt-12 lg:grid-cols-[1.2fr_1fr]">
    <div class="grid content-start gap-6">
      <!-- Email -->
      <section class="card p-6" aria-labelledby="email-title">
        <div class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-accent-quiet text-accent-fg">
            <Icon name="mail" size={18} />
          </span>
          <div>
            <h2 id="email-title" class="font-semibold">Email</h2>
            <p class="text-sm text-fg-subtle">The quickest way to reach me</p>
          </div>
        </div>
        <p class="mt-5 text-lg font-medium break-all">
          <a class="link" href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href={`mailto:${profile.email}`} class="btn btn-primary btn-sm">
            <Icon name="mail" size={15} /> Write an email
          </a>
          <CopyButton value={profile.email} label="Copy address" />
        </div>
      </section>

      <!-- Scheduling -->
      {
        calendlyUrl ? (
          <section class="card p-6" aria-labelledby="schedule-title">
            <div class="flex items-center gap-3">
              <span class="grid size-10 place-items-center rounded-xl bg-accent-quiet text-accent-fg">
                <Icon name="calendar" size={18} />
              </span>
              <div>
                <h2 id="schedule-title" class="font-semibold">Book a call</h2>
                <p class="text-sm text-fg-subtle">Pick a time that suits you</p>
              </div>
            </div>
            <a href={calendlyUrl} class="btn btn-secondary btn-sm mt-5" rel="noopener">
              Choose a time on Calendly <Icon name="arrow-up-right" size={15} />
            </a>
          </section>
        ) : (
          SHOW_DRAFTS && (
            <section class="rounded-2xl border border-dashed border-draft-fg/50 bg-draft-bg/40 p-6" aria-labelledby="schedule-title">
              <h2 id="schedule-title" class="flex items-center gap-2 font-semibold">
                Book a call <DraftBadge draft />
              </h2>
              <p class="mt-2 text-sm text-draft-fg">
                Set <code class="font-mono">calendlyUrl</code> in src/data/profile.ts to show a scheduling card here.
                Hidden in production until then.
              </p>
            </section>
          )
        )
      }

      <ContactForm />
    </div>

    <div class="grid content-start gap-6">
      {
        showWorkTypes && (
          <section class="card p-6" aria-labelledby="work-title">
            <h2 id="work-title" class="flex items-center gap-2 font-semibold">
              Work I'm interested in
              <DraftBadge draft={workTypes.draft} />
            </h2>
            <ul class="mt-4 grid gap-4">
              {workTypes.items.map((w) => (
                <li class="flex gap-3">
                  <Icon name="check" size={16} class="mt-1 text-success-fg" />
                  <div>
                    <p class="font-medium text-fg">{w.title}</p>
                    <p class="text-sm text-fg-muted">{w.detail}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="card p-6" aria-labelledby="elsewhere-title">
        <h2 id="elsewhere-title" class="font-semibold">Elsewhere</h2>
        <ul class="mt-4 grid gap-1">
          {
            profile.socials.map((s) => (
              <li>
                <a href={s.url} rel="me noopener" class="group -mx-2 flex min-h-11 items-center gap-3 rounded-lg px-2 hover:bg-sunken">
                  <Icon name={s.id as 'github'} size={18} class="text-fg-subtle group-hover:text-fg" />
                  <span class="font-medium text-fg">{s.label}</span>
                  <span class="ml-auto font-mono text-sm text-fg-subtle">{s.handle}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={profile.phone.href} class="group -mx-2 flex min-h-11 items-center gap-3 rounded-lg px-2 hover:bg-sunken">
              <Icon name="phone" size={18} class="text-fg-subtle group-hover:text-fg" />
              <span class="font-medium text-fg">Phone</span>
              <span class="ml-auto font-mono text-sm text-fg-subtle">{profile.phone.display}</span>
            </a>
          </li>
        </ul>
      </section>

      <section class="card p-6" aria-labelledby="cv-title">
        <h2 id="cv-title" class="font-semibold">CV</h2>
        <p class="mt-1 text-sm text-fg-muted">A one-file summary of everything on this site.</p>
        <a href={href(profile.resume)} class="btn btn-secondary btn-sm mt-4" download>
          <Icon name="download" size={15} /> Download PDF
        </a>
      </section>
    </div>
  </div>
</BaseLayout>
