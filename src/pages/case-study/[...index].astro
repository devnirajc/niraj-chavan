---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import CaseStudyCard from '@/components/cards/CaseStudyCard.astro';
import { published, pathsWhenVisible } from '@/lib/drafts';

export const getStaticPaths = () => pathsWhenVisible('caseStudies');

const studies = (await published('caseStudies')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Case studies"
  description="In-depth engineering case studies: the problem, the architecture, the decisions and trade-offs, and the outcome."
>
  <PageHeader
    eyebrow="Case studies"
    title="The long version"
    lede="Each case study walks through the business problem, the constraints, the architecture — with an interactive diagram — the decisions I made and the ones I didn't, and what changed as a result."
  />
  <div class="container-page grid gap-5 pt-12 md:grid-cols-2">
    {studies.map((study) => <CaseStudyCard study={study} headingLevel="h2" />)}
  </div>
</BaseLayout>
