---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { href } from '@/lib/url';
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="container-page grid min-h-[60vh] place-items-center py-20 text-center" aria-labelledby="nf-title">
    <div>
      <p class="font-mono text-sm text-accent-fg">404</p>
      <h1 id="nf-title" class="mt-3 text-title font-semibold">This page doesn't exist</h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-fg-muted">
        It may have moved when the site was rebuilt. Search for it, or start from the beginning.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <button type="button" class="btn btn-primary" data-search-open aria-haspopup="dialog">
          <Icon name="search" size={16} /> Search the site
        </button>
        <a href={href('/')} class="btn btn-secondary">Go to the home page</a>
      </div>
    </div>
  </section>
</BaseLayout>
