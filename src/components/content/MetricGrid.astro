---
/**
 * Before → after outcomes. The "after" value leads; the "before" sits beneath
 * it with the arrow spelled out for screen readers ("from 4.8 s").
 */
interface Props {
  metrics: { label: string; before?: string; after: string; note?: string }[];
  label?: string;
}

const { metrics, label = 'Outcomes' } = Astro.props;
---

{
  metrics.length > 0 && (
    <ul
      class:list={[
        'grid gap-px overflow-hidden rounded-2xl border border-line bg-line',
        metrics.length === 2 && 'sm:grid-cols-2',
        metrics.length === 3 && 'sm:grid-cols-3',
        metrics.length === 4 && 'sm:grid-cols-2 lg:grid-cols-4',
        metrics.length > 4 && 'sm:grid-cols-2 sm:span-odd-last lg:grid-cols-3 lg:span-odd-last-none',
      ]}
      aria-label={label}
    >
      {metrics.map((m) => (
        <li class="bg-surface p-5">
          <p class="eyebrow">{m.label}</p>
          <p class="mt-3 text-3xl font-semibold tracking-tight text-fg tabular-nums">{m.after}</p>
          {m.before && (
            <p class="mt-1 text-sm text-fg-subtle">
              <span aria-hidden="true">from </span>
              <span class="sr-only">previously </span>
              <span class="line-through decoration-fg-subtle/60">{m.before}</span>
            </p>
          )}
          {m.note && <p class="mt-3 text-sm leading-relaxed text-fg-muted">{m.note}</p>}
        </li>
      ))}
    </ul>
  )
}
