---
/**
 * An off-site link: opens in a new tab and tells screen readers so. Every
 * external link goes through here — templates directly, MDX bodies through
 * the `a` mapping in components/mdx — so the behaviour lives in one place.
 * mailto: and site links stay plain <a>: neither opens a tab.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  /** What screen readers hear after the link text. */
  note?: string;
}

const { note = 'opens in a new tab', rel, ...attrs } = Astro.props;
// Keep tokens such as "me" (identity links) and always add noopener.
const relTokens = new Set([...String(rel ?? '').split(/\s+/).filter(Boolean), 'noopener']);
---

<a {...attrs} target="_blank" rel={[...relTokens].join(' ')}><slot /><span class="sr-only"> ({note})</span></a>
