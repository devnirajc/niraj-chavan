---
interface Props {
  items: readonly string[];
  label?: string;
  size?: 'sm' | 'md';
}
const { items, label = 'Technologies', size = 'md' } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="flex flex-wrap gap-1.5" aria-label={label}>
      {items.map((item) => (
        <li class:list={['chip', size === 'sm' && 'min-h-6 px-2 text-xs']}>{item}</li>
      ))}
    </ul>
  )
}
