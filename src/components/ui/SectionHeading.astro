---
/**
 * Section opener used on the home page chapters and long pages:
 * "01 — Eyebrow", an <h2>, a lede and an optional "see all" link.
 */
import Icon from './Icon.astro';
import { href as toHref } from '@/lib/url';

interface Props {
  id: string;
  index?: string;
  eyebrow: string;
  title: string;
  lede?: string;
  link?: { label: string; href: string };
}

const { id, index, eyebrow, title, lede, link } = Astro.props;
---

<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
  <div class="max-w-2xl">
    <p class="eyebrow flex items-center gap-2">
      {index && <span class="text-accent-fg">{index}</span>}
      {index && <span aria-hidden="true" class="h-px w-6 bg-line" />}
      {eyebrow}
    </p>
    <h2 id={id} class="mt-3 text-heading font-semibold">{title}</h2>
    {lede && <p class="mt-3 text-base leading-relaxed text-fg-muted sm:text-lg">{lede}</p>}
  </div>
  {
    link && (
      <a href={toHref(link.href)} class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-accent-fg hover:text-accent-hover">
        {link.label}
        <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-0.5" />
      </a>
    )
  }
</div>
