---
/**
 * An image with a light and a dark master, swapped by the data-theme
 * attribute. Both copies are lazy, so the hidden one is never fetched (a lazy
 * image with display: none never reaches the viewport) until the theme
 * changes. With `priority`, a one-line inline script promotes the visible copy
 * to an eager, high-priority fetch as soon as it is parsed — the head
 * bootstrap has set data-theme by then. Without a `dark` master it is a plain
 * <Image>.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  /** Above the fold: fetch eagerly at high priority. */
  priority?: boolean;
}

const { light, dark, alt, widths, sizes, class: className, priority = false } = Astro.props;
---

{
  dark ? (
    <>
      <Image src={light} {alt} {widths} {sizes} class:list={['block dark:hidden', className]} loading="lazy" />
      <Image src={dark} {alt} {widths} {sizes} class:list={['hidden dark:block', className]} loading="lazy" />
      {priority && (
        <script is:inline>
          (function (s) {
            var img = document.documentElement.dataset.theme === 'dark' ? s.previousElementSibling : s.previousElementSibling.previousElementSibling;
            img.fetchPriority = 'high';
            img.loading = 'eager';
          })(document.currentScript);
        </script>
      )}
    </>
  ) : (
    <Image
      src={light}
      {alt}
      {widths}
      {sizes}
      class:list={['block', className]}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  )
}
