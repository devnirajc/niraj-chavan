---
/**
 * A numbered walkthrough — "how I solved this", "how I debug". Used by the
 * playbooks and available in MDX as <Steps steps={[…]} />.
 */
interface Props {
  steps: { title: string; detail: string }[];
  label?: string;
}

const { steps, label } = Astro.props;
---

<ol class="relative grid gap-0" aria-label={label}>
  {
    steps.map((step, i) => (
      <li class="relative grid grid-cols-[2.5rem_1fr] gap-4 pb-8 last:pb-0">
        {i < steps.length - 1 && <span aria-hidden="true" class="absolute top-10 bottom-0 left-5 w-px bg-line" />}
        <span
          aria-hidden="true"
          class="relative grid size-10 place-items-center rounded-full border border-line bg-surface font-mono text-sm font-medium text-accent-fg"
        >
          {String(i + 1).padStart(2, '0')}
        </span>
        <div class="pt-2">
          <h3 class="font-semibold">
            <span class="sr-only">Step {i + 1}: </span>
            {step.title}
          </h3>
          <p class="mt-1.5 leading-relaxed text-fg-muted">{step.detail}</p>
        </div>
      </li>
    ))
  }
</ol>
