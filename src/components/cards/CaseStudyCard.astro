---
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import DraftBadge from '@/components/ui/DraftBadge.astro';
import { DOMAIN_LABELS } from '@/data/taxonomy';
import { href } from '@/lib/url';

interface Props {
  study: CollectionEntry<'caseStudies'>;
  headingLevel?: 'h2' | 'h3';
}

const { study, headingLevel: H = 'h3' } = Astro.props;
const { data } = study;
const headline = data.metrics.find((m) => !/todo/i.test(m.after));
---

<article class="card card-interactive group flex flex-col p-6">
  <div class="flex items-start justify-between gap-3">
    <p class="eyebrow">{data.industry}</p>
    <DraftBadge draft={data.draft} />
  </div>
  <H class="mt-3 text-xl font-semibold tracking-tight">
    <a href={href(`/case-study/${study.id}/`)} class="card-link">{data.title}</a>
  </H>
  <p class="mt-2 leading-relaxed text-fg-muted">{data.summary}</p>

  {
    headline && (
      <p class="mt-5 flex items-baseline gap-2 border-t border-line-subtle pt-4">
        <span class="text-2xl font-semibold tracking-tight tabular-nums">{headline.after}</span>
        <span class="text-sm text-fg-subtle">{headline.label}</span>
      </p>
    )
  }

  <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-5">
    {data.domains.map((d) => <span class="chip min-h-6 px-2 text-xs">{DOMAIN_LABELS[d]}</span>)}
    <Icon name="arrow-up-right" size={18} class="ml-auto text-fg-subtle transition-colors group-hover:text-accent-fg" />
  </div>
</article>
