---
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import { formatDate, isoDate } from '@/lib/dates';

interface Props {
  article: CollectionEntry<'articles'>;
  headingLevel?: 'h2' | 'h3';
  showTags?: boolean;
}

const { article, headingLevel: H = 'h3', showTags = true } = Astro.props;
const { data } = article;
---

<article
  class="card card-interactive group flex flex-col p-6"
  data-filter-item
  data-filter-tags={data.categories.join('|')}
>
  <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-fg-subtle">
    <time datetime={isoDate(data.published)}>{formatDate(data.published)}</time>
    <span aria-hidden="true">·</span>
    <span>{data.readingMinutes} min read</span>
    {
      data.featured && (
        <span class="ml-auto inline-flex items-center gap-1 font-mono text-[0.6875rem] tracking-wider text-accent-fg uppercase">
          <Icon name="sparkles" size={12} /> Featured
        </span>
      )
    }
  </p>
  <H class="mt-3 text-lg font-semibold tracking-tight">
    <a href={data.url} class="card-link" rel="noopener">
      {data.title}
      <span class="sr-only"> (on Medium)</span>
    </a>
  </H>
  <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-fg-muted">{data.excerpt}</p>
  <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-5">
    {data.categories.map((c) => <span class="chip min-h-6 px-2 text-xs">{c}</span>)}
    {showTags && data.tags.filter((t) => !data.categories.some((c) => c.toLowerCase() === t)).slice(0, 3).map((t) => (
      <span class="font-mono text-xs text-fg-subtle">#{t}</span>
    ))}
    <span class="ml-auto inline-flex items-center gap-1 text-xs text-fg-subtle" aria-hidden="true">
      Medium <Icon name="arrow-up-right" size={14} />
    </span>
  </div>
</article>
