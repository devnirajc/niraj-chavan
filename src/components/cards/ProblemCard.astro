---
/**
 * One enterprise problem as a summary card: domain, the problem and the
 * headline result. The whole card links to /problems/<id>/, where the full
 * Challenge → Analysis → Solution → Results → Lessons walkthrough lives.
 */
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import DraftBadge from '@/components/ui/DraftBadge.astro';
import { DOMAIN_LABELS } from '@/data/taxonomy';
import { href } from '@/lib/url';

interface Props {
  problem: CollectionEntry<'problems'>;
  headingLevel?: 'h2' | 'h3';
}

const { problem, headingLevel: H = 'h3' } = Astro.props;
const { data } = problem;
---

<article class="card card-interactive group flex h-full flex-col p-6" data-filter-item data-filter-tags={data.domain} id={problem.id}>
  <div class="flex flex-wrap items-center gap-2">
    <span class="chip min-h-6 px-2 text-xs">{DOMAIN_LABELS[data.domain]}</span>
    <span class="text-xs text-fg-subtle">{data.context}</span>
    <DraftBadge draft={data.draft} class="ml-auto" />
  </div>
  <H class="mt-3 text-lg font-semibold tracking-tight">
    <a href={href(`/problems/${problem.id}/`)} class="card-link">{data.title}</a>
  </H>
  <p class="mt-2 leading-relaxed text-fg-muted">{data.problem}</p>
  <p class="mt-4 flex gap-2 text-sm text-fg">
    <Icon name="check" size={16} class="mt-0.5 text-success-fg" />
    <span><span class="sr-only">Headline result: </span>{data.results[0]}</span>
  </p>
  <p class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-medium text-accent-fg" aria-hidden="true">
    How I solved it
    <Icon name="arrow-right" size={15} class="transition-transform group-hover:translate-x-0.5" />
  </p>
</article>
