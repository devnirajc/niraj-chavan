---
/**
 * Home hero: who I am, what I specialise in, where I have worked, and how
 * long — told as a sentence, then backed by an "inspector" panel of facts.
 */
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import portrait from '@/assets/portrait.jpg';
import { profile, domains, highlights } from '@/data/profile';
import { href } from '@/lib/url';
import { hasVisible } from '@/lib/nav';

interface Props {
  companies: number;
}

const { companies } = Astro.props;
const hasCaseStudies = await hasVisible('caseStudies');
const status = { label: profile.availability.label, live: profile.availability.status !== 'unavailable' };
const stats = highlights.map((h) => (h.label.startsWith('companies') ? { ...h, value: String(companies) } : h));
---

<section class="relative overflow-hidden border-b border-line-subtle" aria-labelledby="hero-title">
  <div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0"></div>
  <div aria-hidden="true" class="bg-glow pointer-events-none absolute inset-0"></div>

  <div class="container-page relative grid gap-12 pt-14 pb-16 sm:pt-20 lg:grid-cols-[1.35fr_1fr] lg:items-center lg:gap-16 lg:pb-24">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 py-1 pr-3 pl-1.5 text-sm text-fg-muted shadow-sm">
        <span class="rounded-full bg-accent-quiet px-2 py-0.5 font-mono text-xs font-medium text-accent-fg">{profile.years} yrs</span>
        {profile.role} · {profile.location}
      </p>

      <h1 id="hero-title" class="mt-6 text-display font-semibold">
        I turn complex enterprise requirements into
        <span class="text-accent-fg">fast, accessible interfaces.</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-fg-muted">
        I'm {profile.name} — a senior UI engineer with {profile.years} years across banking, energy, cybersecurity
        and e-commerce. Today I build enterprise travel platforms at {profile.current.company}, where the work is less
        about frameworks and more about making complicated things feel obvious.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        {
          hasCaseStudies ? (
            <a href={href('/case-study/')} class="btn btn-primary">
              View case studies
              <Icon name="arrow-right" size={16} />
            </a>
          ) : (
            <a href={href('/projects/')} class="btn btn-primary">
              Explore projects
              <Icon name="arrow-right" size={16} />
            </a>
          )
        }
        {
          hasCaseStudies && (
            <a href={href('/projects/')} class="btn btn-secondary">
              Explore projects
            </a>
          )
        }
        <a href={href('/about/')} class="btn btn-secondary">My story</a>
      </div>
      <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href={href('/writing/')} class="group inline-flex items-center gap-1.5 text-fg-muted hover:text-fg">
          <Icon name="book-open" size={15} /> Read my writing
        </a>
        <a href={href('/contact/')} class="group inline-flex items-center gap-1.5 text-fg-muted hover:text-fg">
          <Icon name="mail" size={15} /> Contact me
        </a>
        <a href={href(profile.resume)} class="group inline-flex items-center gap-1.5 text-fg-muted hover:text-fg" download>
          <Icon name="download" size={15} /> Download CV <span class="sr-only">(PDF)</span>
        </a>
      </p>
    </div>

    <!-- Inspector: the same facts as a structured panel. -->
    <aside class="card overflow-hidden shadow-lg" aria-label="Profile at a glance">
      <div class="flex items-center gap-2 border-b border-line bg-sunken/60 px-4 py-2.5" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-line"></span>
        <span class="size-2.5 rounded-full bg-line"></span>
        <span class="size-2.5 rounded-full bg-line"></span>
        <span class="ml-2 font-mono text-xs text-fg-subtle">profile.inspect</span>
      </div>
      <div class="flex items-center gap-4 p-5">
        <!--
          The source is a square head-and-shoulders portrait, which leaves the
          face small at 64px. Zoom in on it with CSS instead of keeping a second
          cropped master: the image is rendered at 1.8x inside a clipped tile,
          anchored near the top so the face fills the frame. Sized at 116px
          (64 x 1.8), with a 2x density, so the zoom stays sharp.
        -->
        <span class="size-16 shrink-0 overflow-hidden rounded-2xl border border-line bg-sunken">
          <Image
            src={portrait}
            alt=""
            width={116}
            height={116}
            densities={[1, 2]}
            loading="eager"
            class="size-full origin-[50%_11%] scale-[1.8] object-cover"
          />
        </span>
        <div>
          <p class="text-lg font-semibold tracking-tight">{profile.name}</p>
          <p class="text-sm text-fg-muted">{profile.role}</p>
        </div>
      </div>
      <dl class="grid border-t border-line text-sm">
        {
          [
            ['Currently', `${profile.current.title}, ${profile.current.company}`],
            ['Experience', `${profile.years} years · since ${profile.careerStart.slice(0, 4)}`],
            ['Based in', `${profile.location} · ${profile.timezone}`],
            ['Focus', 'Angular · React · TypeScript · Design systems · Accessibility'],
          ].map(([term, value]) => (
            <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-b border-line-subtle px-5 py-2.5">
              <dt class="text-fg-subtle">{term}</dt>
              <dd class="text-fg">{value}</dd>
            </div>
          ))
        }
        {
          profile.availability.showInHero && (
            <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-b border-line-subtle px-5 py-2.5">
              <dt class="text-fg-subtle">Status</dt>
              <dd class="flex items-center gap-2 text-fg">
                <span
                  aria-hidden="true"
                  class:list={['size-2 shrink-0 rounded-full', status.live ? 'bg-success' : 'bg-line-strong']}
                ></span>
                {status.label}
              </dd>
            </div>
          )
        }
      </dl>
      <div class="p-5">
        <p class="eyebrow">Industries</p>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {domains.map((d) => <li class="chip min-h-6 px-2 text-xs">{d.name}</li>)}
        </ul>
      </div>
    </aside>
  </div>

  <div class="container-page relative pb-14">
    <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line lg:grid-cols-4" aria-label="Highlights">
      {
        stats.map((h) => (
          <li class="bg-surface/90 px-5 py-5">
            <p class="text-3xl font-semibold tracking-tight tabular-nums">{h.value}</p>
            <p class="mt-1 text-sm text-fg-muted">{h.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
