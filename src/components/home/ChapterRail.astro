---
/**
 * The home page reads as a guided tour in chapters. On wide screens this
 * rail sits in the left margin, showing where you are in the story
 * (aria-current="true" on the chapter in view) and letting you jump ahead.
 * A short line marks each chapter and grows to show the current one.
 */
interface Props {
  chapters: { id: string; label: string }[];
}

const { chapters } = Astro.props;
---

<nav
  aria-label="Chapters"
  class="fixed top-1/2 left-6 z-30 hidden -translate-y-1/2 min-[90rem]:block"
  data-chapter-rail
>
  <ol class="grid gap-1">
    {
      chapters.map((c) => (
        <li>
          <a
            href={`#${c.id}`}
            class="group flex items-center gap-3 rounded-md py-1 pr-2 text-xs text-fg-subtle transition-colors hover:text-fg aria-[current=true]:text-fg"
          >
            <span
              aria-hidden="true"
              class="h-px w-4 bg-line transition-all group-hover:w-6 group-aria-[current=true]:w-8 group-aria-[current=true]:bg-accent-solid"
            />
            <span>{c.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const rail = document.querySelector<HTMLElement>('[data-chapter-rail]');
  if (rail) {
    const links = [...rail.querySelectorAll<HTMLAnchorElement>('a')];

    // Watch each chapter's whole <section>, not just its heading. A heading is
    // a thin strip that only "crosses" the middle band while scrolling past
    // it, so jumping straight to a chapter (a rail click under reduced
    // motion, a deep link) never marked anything current.
    const chapterOf = new Map<Element, string>();
    for (const a of links) {
      const id = a.hash.slice(1);
      const section = document.getElementById(id)?.closest('section');
      if (section) chapterOf.set(section, id);
    }

    const setCurrent = (id: string) =>
      links.forEach((a) => a.setAttribute('aria-current', String(a.hash === `#${id}`)));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setCurrent(chapterOf.get(entry.target)!);
        }
      },
      // A chapter is "current" while it occupies the middle band of the screen.
      { rootMargin: '-45% 0px -50% 0px' }
    );
    chapterOf.forEach((_, section) => observer.observe(section));
  }
</script>
