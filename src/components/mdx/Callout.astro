---
/** <Callout title="Trade-off">…</Callout> — an aside inside long-form prose. */
import Icon from '@/components/ui/Icon.astro';

interface Props {
  title?: string;
  kind?: 'note' | 'tradeoff' | 'lesson';
}

const { title, kind = 'note' } = Astro.props;
const icon = { note: 'lightbulb', tradeoff: 'compass', lesson: 'flag' } as const;
const label = title ?? { note: 'Note', tradeoff: 'Trade-off', lesson: 'Lesson' }[kind];
---

<aside class="my-8 rounded-xl border border-accent-line bg-accent-quiet/50 px-5 py-4">
  <p class="flex items-center gap-2 text-sm font-semibold text-accent-fg">
    <Icon name={icon[kind]} size={16} />
    {label}
  </p>
  <div class="mt-2 text-[0.9375rem] leading-relaxed text-fg-muted [&>*+*]:mt-3">
    <slot />
  </div>
</aside>
