{
  "name": "niraj-chavan-portfolio",
  "version": "3.0.0",
  "description": "Portfolio of Niraj Chavan — senior software engineer. Case studies, projects, writing and the thinking behind them.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:published": "astro dev --mode published",
    "build": "npm run check:contrast && npm run check:content && astro build",
    "build:drafts": "astro build --mode drafts --outDir ./dist-drafts",
    "preview": "astro preview",
    "check": "astro check && npm run check:contrast && npm run check:content",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:content": "node scripts/check-content.mjs",
    "content:status": "node scripts/check-content.mjs --report",
    "sync:medium": "node scripts/sync-medium.mjs",
    "icons": "node scripts/generate-icons.js",
    "og": "node scripts/generate-og.js",
    "resume": "node scripts/build-resume.mjs",
    "postinstall": "node scripts/wasi-fallback.mjs"
  },
  "author": "Niraj Chavan",
  "license": "MIT",
  "dependencies": {
    "@astrojs/mdx": "^8.1.5",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "fast-xml-parser": "^5.11.2",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
